/src/aflsim/app/web/js/analysis/setup_page.js
/src/aflsim/app/web/js/analysis/view3d.js
/src/aflsim/app/web/vendor/

# --- 4. never, anywhere
.env
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
*.mp4
