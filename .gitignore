/src/aflsim/games/afl8/controllers/jev.py
/src/aflsim/games/afl8/controllers/coached.py
/src/aflsim/games/afl8/analysis.py
/src/aflsim/games/afl18/analysis.py
/src/aflsim/app/api/analysis.py
/src/aflsim/app/api/lab.py
/src/aflsim/app/lab_services.py
/src/aflsim/lab_cli.py
/src/aflsim/app/web/js/sections/lab.js
/src/aflsim/app/web/js/lab/
