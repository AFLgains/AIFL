# ============================================================================================================
# PUBLIC REPOSITORY: a WHITELIST. Everything is private by default; only what is un-ignored below is published:
# the game engine (AFL8 and AFL18), the web app (Develop / Play / Inspect, play-it-yourself, the retro viewer),
# the templates for writing bots, and the documentation. Anything new you create stays private unless you add it
# here on purpose.
#
# Check before every push:   git status        (only what you mean to publish should be listed)
# ============================================================================================================

# --- 1. ignore everything at the top level ...
/*

# --- 2. ... then publish these
!/.gitignore
!/.env.example
!/.github/
!/docs/
!/pyproject.toml
!/requirements.lock
!/afl.py
!/run_app.bat
!/run_replayhub.sh
!/LICENSE

# the package: the engine, the match machinery, the bot tooling and the app
!/src/
/src/*
!/src/aflsim/
!/src/replayhub/
/src/replayhub/*
!/src/replayhub/README.md
!/src/replayhub/index.html
!/src/replayhub/package.json
!/src/replayhub/package-lock.json
!/src/replayhub/vite.config.ts
!/src/replayhub/tsconfig.json
!/src/replayhub/tsconfig.app.json
!/src/replayhub/tsconfig.node.json
!/src/replayhub/eslint.config.js
!/src/replayhub/src/
!/src/replayhub/public/
/src/replayhub/node_modules/
/src/replayhub/dist/
/src/aflsim/*
!/src/aflsim/__init__.py
!/src/aflsim/__main__.py
!/src/aflsim/paths.py
!/src/aflsim/cli.py
!/src/aflsim/engine/
!/src/aflsim/exec/
!/src/aflsim/match/
!/src/aflsim/video/
!/src/aflsim/bots/
!/src/aflsim/games/
!/src/aflsim/app/

# --- 3. private files inside the published folders
/src/aflsim/games/afl8/encode.py
/src/aflsim/games/afl8/search.py
/src/aflsim/games/afl8/prompts.py
/src/aflsim/games/afl8/prompts_coached.py
